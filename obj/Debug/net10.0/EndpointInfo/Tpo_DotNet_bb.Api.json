  "components": {
    "schemas": {
      "ClienteDto": {
        "required": [
          "Apellido",
          "Direccion",
          "Email",
          "Nombre",
          "Password"
        ],
        "type": "object",
        "properties": {
          "Email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "Apellido": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9]+$",
            "type": "string"
          },
          "Nombre": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9]+$",
            "type": "string"
          },
          "Direccion": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\s,.'-]{3,}$",
            "type": "string"
          },
          "Password": {
            "minLength": 1,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[\\W_]).{8,}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "Email",
          "Password"
        ],
        "type": "object",
        "properties": {
          "Email": {
            "minLength": 1,
            "type": "string"
          },
          "Password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDto": {
        "required": [
          "FECHA_COMPRA",
          "IDESTADO",
          "IDPRODUCTO"
        ],
        "type": "object",
        "properties": {
          "FECHA_COMPRA": {
            "type": "string",
