          },
          "IDPRODUCTO": {
            "type": "integer",
            "format": "int32"
          },
          "IDESTADO": {
            "type": "integer",
            "format": "int32"
          },
          "CANTIDAD": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "PRECIO": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "IMPORTE": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
